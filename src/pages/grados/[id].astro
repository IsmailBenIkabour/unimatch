---
// src/pages/grados/[id].astro
import MainLayout from '../../layouts/MainLayout.astro';
import gradosData from '../../data/grados.json';

export async function getStaticPaths() {
  return gradosData.map((grado) => ({
    params: { id: grado.id },
    props: { grado },
  }));
}

const { grado } = Astro.props;

// Datos estructurados Schema.org (EducationalOccupationalProgram) para SEO
const schemaOrg = {
  "@context": "https://schema.org",
  "@type": "EducationalOccupationalProgram",
  "name": grado.nombre,
  "provider": {
    "@type": "CollegeOrUniversity",
    "name": grado.universidad
  },
  "educationalCredentialAwarded": "Grado Universitario",
  "timeToComplete": "P4Y"
};
---

<MainLayout 
  title={`${grado.nombre} en ${grado.universidad} | Nota de Corte ${grado.notaCorte2026} - UniMatchES`}
  description={`Consulta la nota de corte 2026 (${grado.notaCorte2026}), precio del crédito, salidas profesionales y ponderaciones del Grado en ${grado.nombre} en la ${grado.universidad}.`}
>
  <!-- SCRIPT DE DATOS ESTRUCTURADOS SCHEMA.ORG -->
  <script type="application/ld+json" set:html={JSON.stringify(schemaOrg)} />

  <div class="space-y-8 py-6 max-w-4xl mx-auto">
    
    <!-- MIGAS DE PAN / NAVEGACIÓN ATRÁS -->
    <div>
      <a href="/" class="inline-flex items-center gap-2 text-xs font-medium text-slate-400 hover:text-amber-400 transition-colors">
        ← Volver al buscador general
      </a>
    </div>

    <!-- CABECERA DE LA TITULACIÓN -->
    <div class="relative overflow-hidden bg-slate-900/40 border border-slate-800/80 rounded-3xl p-6 sm:p-8 backdrop-blur-xl space-y-6">
      <div class="absolute top-0 left-0 right-0 h-[2px] bg-gradient-to-r from-transparent via-amber-400/50 to-transparent"></div>

      <div class="flex flex-wrap items-center gap-3">
        <span class="text-xs font-bold px-3 py-1 rounded-full bg-slate-800 text-slate-300">
          {grado.rama}
        </span>
        <span class="text-xs font-bold px-3 py-1 rounded-full bg-amber-400/10 text-amber-400 border border-amber-400/20">
          {grado.tipo}
        </span>
        <span class="text-xs font-mono text-slate-400">
          📍 {grado.ciudad} ({grado.comunidad})
        </span>
      </div>

      <div class="space-y-2">
        <h1 class="text-2xl sm:text-4xl font-black text-white tracking-tight">
          {grado.nombre}
        </h1>
        <p class="text-sm sm:text-base text-slate-400 font-medium">
          {grado.universidad}
        </p>
      </div>

      <!-- MÉTRICAS CLAVE EN TARJETAS INTERNAS -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 pt-4 border-t border-slate-800/80">
        
        <div class="bg-slate-950/60 p-4 rounded-2xl border border-slate-800/60 space-y-1">
          <span class="text-[11px] font-bold text-slate-400 uppercase">Nota Corte 2026</span>
          <div class="text-xl sm:text-2xl font-black text-amber-400 font-mono">
            {grado.notaCorte2026.toFixed(3)}
          </div>
        </div>

        <div class="bg-slate-950/60 p-4 rounded-2xl border border-slate-800/60 space-y-1">
          <span class="text-[11px] font-bold text-slate-400 uppercase">Plazas Ofertadas</span>
          <div class="text-xl sm:text-2xl font-black text-white font-mono">
            {grado.plazas}
          </div>
        </div>

        <div class="bg-slate-950/60 p-4 rounded-2xl border border-slate-800/60 space-y-1">
          <span class="text-[11px] font-bold text-slate-400 uppercase">Precio / Crédito</span>
          <div class="text-xl sm:text-2xl font-black text-white font-mono">
            {grado.precioCredito} €
          </div>
        </div>

        <div class="bg-slate-950/60 p-4 rounded-2xl border border-slate-800/60 space-y-1">
          <span class="text-[11px] font-bold text-slate-400 uppercase">Empleabilidad</span>
          <div class="text-xl sm:text-2xl font-black text-emerald-400 font-mono">
            {grado.empleabilidad}%
          </div>
        </div>

      </div>
    </div>

    <!-- BLOQUES DE INFORMACIÓN DETALLADA -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      
      <!-- HISTÓRICO DE NOTAS DE CORTE -->
      <div class="bg-slate-900/40 border border-slate-800/80 rounded-3xl p-6 space-y-4 backdrop-blur-xl">
        <h2 class="text-sm font-bold text-white uppercase tracking-wider flex items-center gap-2">
          📊 Histórico de Notas de Corte
        </h2>
        <div class="space-y-3 pt-2">
          <div class="flex justify-between items-center bg-slate-950/60 p-3.5 rounded-xl border border-slate-800/60 text-xs">
            <span class="text-slate-400 font-medium">Convocatoria 2026</span>
            <span class="font-mono font-bold text-amber-400">{grado.notaCorte2026.toFixed(3)}</span>
          </div>
          <div class="flex justify-between items-center bg-slate-950/60 p-3.5 rounded-xl border border-slate-800/60 text-xs">
            <span class="text-slate-400 font-medium">Convocatoria 2025</span>
            <span class="font-mono font-bold text-slate-300">{grado.notaCorte2025.toFixed(3)}</span>
          </div>
          <div class="flex justify-between items-center bg-slate-950/60 p-3.5 rounded-xl border border-slate-800/60 text-xs">
            <span class="text-slate-400 font-medium">Convocatoria 2024</span>
            <span class="font-mono font-bold text-slate-300">{grado.notaCorte2024.toFixed(3)}</span>
          </div>
        </div>
      </div>

      <!-- ASIGNATURAS PONDERABLES -->
      <div class="bg-slate-900/40 border border-slate-800/80 rounded-3xl p-6 space-y-4 backdrop-blur-xl">
        <h2 class="text-sm font-bold text-white uppercase tracking-wider flex items-center gap-2">
          ⚖️ Materias que Ponderan (0.2)
        </h2>
        <ul class="space-y-2.5 pt-2">
          {grado.ponderaciones.map(pond => (
            <li class="bg-slate-950/60 px-4 py-3 rounded-xl border border-slate-800/60 text-xs font-semibold text-slate-300 flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
              {pond}
            </li>
          ))}
        </ul>
      </div>

    </div>

    <!-- SALIDAS PROFESIONALES -->
    <div class="bg-slate-900/40 border border-slate-800/80 rounded-3xl p-6 sm:p-8 space-y-4 backdrop-blur-xl">
      <h2 class="text-sm font-bold text-white uppercase tracking-wider flex items-center gap-2">
        💼 Salidas Profesionales Principales
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-2">
        {grado.salidas.map(salida => (
          <div class="bg-slate-950/60 p-4 rounded-2xl border border-slate-800/60 text-xs font-semibold text-slate-300 flex items-center gap-2">
            <span class="text-amber-400">✦</span>
            {salida}
          </div>
        ))}
      </div>
    </div>

  </div>
</MainLayout>