---
// src/pages/grados/[id].astro
import MainLayout from '../../layouts/MainLayout.astro';
import gradosData from '../../data/grados.json';

export async function getStaticPaths() {
  return gradosData.map((grado) => ({
    params: { id: grado.id },
    props: { grado },
  }));
}

const { grado } = Astro.props;
---

<MainLayout title={`${grado.nombre} | UniMatch Cataluña`}>
  <div class="space-y-8 py-8 max-w-4xl mx-auto px-4">
    
    <a href="/grados" class="text-xs text-amber-400 hover:underline font-mono">← Volver al buscador</a>

    <header class="bg-slate-900/60 border border-slate-800/80 rounded-2xl p-6 space-y-4">
      <div class="flex justify-between items-start gap-4">
        <span class="text-[10px] font-bold px-2.5 py-1 rounded-full bg-slate-800 text-slate-300">
          {grado.rama}
        </span>
        <div class="text-right">
          <span class="text-[10px] text-slate-400 uppercase font-mono block">Nota de corte 2026</span>
          <span class="text-2xl font-mono font-bold text-amber-400">
            {grado.notaCorte2026.toFixed(3)}
          </span>
        </div>
      </div>

      <div>
        <h1 class="text-2xl sm:text-3xl font-black text-white">{grado.nombre}</h1>
        <p class="text-sm text-slate-400 mt-1">{grado.universidad}</p>
        <p class="text-xs text-slate-500 mt-0.5">📍 {grado.ciudad} (Cataluña)</p>
      </div>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="bg-slate-900/60 border border-slate-800/80 rounded-2xl p-5 space-y-3">
        <h3 class="text-xs font-bold text-slate-300 uppercase tracking-wider font-mono">Ponderaciones PAU</h3>
        <ul class="space-y-1.5 text-xs text-slate-400">
          {grado.ponderaciones.map((p) => (
            <li class="bg-slate-950 px-3 py-2 rounded-xl border border-slate-800/60 flex items-center gap-2">
              <span class="text-amber-400">•</span> {p}
            </li>
          ))}
        </ul>
      </div>

      <div class="bg-slate-900/60 border border-slate-800/80 rounded-2xl p-5 space-y-3">
        <h3 class="text-xs font-bold text-slate-300 uppercase tracking-wider font-mono">Salidas Profesionales</h3>
        <ul class="space-y-1.5 text-xs text-slate-400">
          {grado.salidas.map((s) => (
            <li class="bg-slate-950 px-3 py-2 rounded-xl border border-slate-800/60 flex items-center gap-2">
              <span class="text-amber-400">✓</span> {s}
            </li>
          ))}
        </ul>
      </div>
    </div>

  </div>
</MainLayout>