---
// src/pages/404.astro
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Página no encontrada | UniMatch Cataluña">
  <div class="py-20 text-center space-y-4 max-w-md mx-auto px-4">
    <span class="text-4xl font-mono font-black text-amber-400">404</span>
    <h1 class="text-2xl font-bold text-white">Página no encontrada</h1>
    <p class="text-xs text-slate-400">
      La titulación o sección que buscas no existe o ha sido movida dentro del catálogo de Cataluña.
    </p>
    <a 
      href="/" 
      class="inline-block mt-4 text-xs font-semibold text-slate-900 bg-amber-400 hover:bg-amber-300 px-5 py-2.5 rounded-xl transition-colors"
    >
      Volver al inicio
    </a>
  </div>
</MainLayout>