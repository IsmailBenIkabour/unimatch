---
// src/pages/calculadora-pau.astro
import MainLayout from '../layouts/MainLayout.astro';
import CalculadoraPau from '../components/CalculadoraPau.astro';
---

<MainLayout 
  title="Calculadora Nota PAU Cataluña | UniMatch"
  description="Calcula tu nota de admisión sobre 14 puntos para las universidades públicas de Cataluña según los baremos oficiales."
>
  <div class="space-y-10 py-8 max-w-4xl mx-auto px-4">
    
    <header class="text-center space-y-3 max-w-2xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-slate-900 border border-slate-800 text-amber-400 text-xs font-medium tracking-wide">
        <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
        Baremo Oficial PAU Cataluña
      </div>
      
      <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight">
        Calculadora de <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 to-amber-200">Nota PAU</span>
      </h1>
      
      <p class="text-xs sm:text-sm text-slate-400">
        Introduce tus notas del Bachillerato y de las asignaturas de la Fase General y Específica para simular tu nota final de admisión (hasta 14.000).
      </p>
    </header>

    <main class="max-w-xl mx-auto">
      <CalculadoraPau />
    </main>

  </div>
</MainLayout>