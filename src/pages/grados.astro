---
// src/pages/grados.astro
import MainLayout from '../layouts/MainLayout.astro';
import BuscadorGrados from '../components/BuscadorGrados.astro';
import gradosData from '../data/grados.json';

const totalGrados = gradosData.length;
---

<MainLayout 
  title="Catálogo de Grados Universitarios en Cataluña | UniMatch"
  description="Explora la lista completa de carreras universitarias en Cataluña. Filtra por nota de corte, universitat o rama."
>
  <div class="space-y-10 py-8 max-w-5xl mx-auto px-4">
    
    <header class="text-center space-y-3 max-w-2xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-slate-900 border border-slate-800 text-amber-400 text-xs font-medium tracking-wide font-mono">
        <span class="text-amber-400 font-bold">{totalGrados}</span> Ofertas Disponibles
      </div>
      
      <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight">
        Catálogo de <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 to-amber-200">Grados</span>
      </h1>
      
      <p class="text-xs sm:text-sm text-slate-400">
        Encuentra todas las titulaciones de las universidades catalanas ordenadas alfabéticamente con las notas de corte oficiales actualizadas.
      </p>
    </header>

    <main class="pt-4">
      <BuscadorGrados />
    </main>

  </div>
</MainLayout>