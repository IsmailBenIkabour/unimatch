---
// src/pages/comparar.astro
import MainLayout from '../layouts/MainLayout.astro';
import ComparadorGrados from '../components/ComparadorGrados.astro';
---

<MainLayout 
  title="Comparador de Grados y Universidades | UniMatchES"
  description="Compara dos grados universitarios en España frente a frente: notas de corte, precio de matrícula, salidas laborales y ponderaciones oficial."
>
  <div class="space-y-8 py-4 max-w-4xl mx-auto">
    
    <div class="space-y-2 text-center">
      <h1 class="text-3xl sm:text-4xl font-black text-white tracking-tight">
        Comparador de <span class="text-amber-400">Titulaciones Universitarias</span>
      </h1>
      <p class="text-xs sm:text-sm text-slate-400 max-w-xl mx-auto">
        ¿Dudas entre dos carreras o universidades? Compara todos los datos oficiales frente a frente para tomar la decisión correcta.
      </p>
    </div>

    <!-- COMPONENTE COMPARADOR -->
    <ComparadorGrados />

  </div>
</MainLayout>