---
// src/pages/comparar.astro
import MainLayout from '../layouts/MainLayout.astro';
import gradosData from '../data/grados.json';

// Ordenar todos los grados alfabéticamente por nombre de forma segura
const gradosOrdenados = [...gradosData]
  .filter(g => g && g.nombre)
  .sort((a, b) => {
    const nombreA = String(a.nombre);
    const nombreB = String(b.nombre);
    return nombreA.localeCompare(nombreB);
  });
---

<MainLayout 
  title="Comparador de Grados Universitarios | UniMatch Cataluña"
  description="Compara notas de corte, plazas, empleabilidad y asignaturas entre dos grados universitarios de Cataluña."
>
  <div class="space-y-8 py-8 max-w-5xl mx-auto px-4">
    <header class="text-center space-y-3 max-w-2xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-slate-900 border border-slate-800 text-amber-400 text-xs font-medium tracking-wide">
        Herramienta de Comparación
      </div>
      <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight">
        Compara <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 to-amber-200">Titulaciones</span>
      </h1>
      <p class="text-xs sm:text-sm text-slate-400">
        Selecciona dos grados para analizar frente a frente sus notas de corte, requisitos de la PAU y perspectivas profesionales.
      </p>
    </header>

    <!-- SELECTORES EN ORDEN ALFABÉTICO -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 bg-slate-900/60 border border-slate-800/80 rounded-2xl p-4 sm:p-6 backdrop-blur-sm">
      <div class="space-y-1.5">
        <label for="grado1Select" class="block text-xs font-semibold text-slate-300">Primer Grado</label>
        <select 
          id="grado1Select" 
          class="w-full bg-slate-950 border border-slate-800 focus:border-amber-400 rounded-xl px-3.5 py-2.5 text-xs text-white outline-none transition"
        >
          <option value="">Selecciona el primer grado...</option>
          {gradosOrdenados.map(g => (
            <option value={g.id || g.slug}>
              {g.nombre} - {g.universidad}
            </option>
          ))}
        </select>
      </div>

      <div class="space-y-1.5">
        <label for="grado2Select" class="block text-xs font-semibold text-slate-300">Segundo Grado</label>
        <select 
          id="grado2Select" 
          class="w-full bg-slate-950 border border-slate-800 focus:border-amber-400 rounded-xl px-3.5 py-2.5 text-xs text-white outline-none transition"
        >
          <option value="">Selecciona el segundo grado...</option>
          {gradosOrdenados.map(g => (
            <option value={g.id || g.slug}>
              {g.nombre} - {g.universidad}
            </option>
          ))}
        </select>
      </div>
    </div>

    <!-- PANEL DE COMPARACIÓN -->
    <div id="comparativaContainer" class="hidden grid-cols-1 md:grid-cols-2 gap-6">
      <!-- Tarjeta Grado 1 -->
      <div id="cardGrado1" class="bg-slate-900/60 border border-slate-800/80 rounded-2xl p-6 space-y-6"></div>

      <!-- Tarjeta Grado 2 -->
      <div id="cardGrado2" class="bg-slate-900/60 border border-slate-800/80 rounded-2xl p-6 space-y-6"></div>
    </div>

    <!-- MENSAJE INICIAL -->
    <div id="mensajeInicial" class="text-center py-12 bg-slate-900/30 border border-slate-800/60 rounded-2xl space-y-2">
      <p class="text-sm font-semibold text-slate-400">Selecciona dos titulaciones arriba para ver la comparativa detallada.</p>
    </div>
  </div>
</MainLayout>

<script define:vars={{ gradosOrdenados }}>
  function setupComparador() {
    const select1 = document.getElementById('grado1Select');
    const select2 = document.getElementById('grado2Select');
    const container = document.getElementById('comparativaContainer');
    const mensajeInicial = document.getElementById('mensajeInicial');
    const card1 = document.getElementById('cardGrado1');
    const card2 = document.getElementById('cardGrado2');

    if (!select1 || !select2) return;

    function renderGrado(grado) {
      if (!grado) return '';
      const nota = typeof grado.notaCorte2026 === 'number' ? grado.notaCorte2026.toFixed(3) : (grado.notaCorte2026 || '0.000');
      
      const ponderacionesHTML = (grado.ponderaciones || [])
        .map(p => `<li class="bg-slate-950 px-3 py-1.5 rounded-lg border border-slate-800/60 text-slate-300 flex items-center gap-2"><span class="text-amber-400">•</span> ${p}</li>`)
        .join('');

      const salidasHTML = (grado.salidas || [])
        .map(s => `<li class="bg-slate-950 px-3 py-1.5 rounded-lg border border-slate-800/60 text-slate-300 flex items-center gap-2"><span class="text-amber-400">✓</span> ${s}</li>`)
        .join('');

      return `
        <div class="space-y-4">
          <div class="space-y-1">
            <span class="text-[10px] font-bold px-2.5 py-1 rounded-full bg-slate-800 text-slate-300 inline-block">${grado.rama || 'Grado'}</span>
            <h2 class="text-xl font-bold text-white mt-2">${grado.nombre}</h2>
            <p class="text-xs text-slate-400">${grado.universidad}</p>
            <p class="text-[11px] text-slate-500">📍 ${grado.ciudad || 'Cataluña'}</p>
          </div>

          <div class="bg-slate-950 p-4 rounded-xl border border-slate-800/80 flex justify-between items-center">
            <span class="text-xs text-slate-400 font-mono">Nota de Corte 2026</span>
            <span class="text-xl font-mono font-bold text-amber-400">${nota}</span>
          </div>

          <div class="grid grid-cols-2 gap-2 text-xs text-center font-mono">
            <div class="bg-slate-950/60 p-2.5 rounded-xl border border-slate-800/50">
              <span class="text-[10px] text-slate-500 block">Plazas</span>
              <span class="font-bold text-slate-200">${grado.plazas || 'N/A'}</span>
            </div>
            <div class="bg-slate-950/60 p-2.5 rounded-xl border border-slate-800/50">
              <span class="text-[10px] text-slate-500 block">Empleabilidad</span>
              <span class="font-bold text-slate-200">${grado.empleabilidad ? grado.empleabilidad + '%' : 'N/A'}</span>
            </div>
          </div>

          <div class="space-y-2">
            <h4 class="text-xs font-bold text-slate-300 font-mono uppercase">Ponderaciones PAU</h4>
            <ul class="space-y-1 text-xs font-mono">${ponderacionesHTML}</ul>
          </div>

          <div class="space-y-2">
            <h4 class="text-xs font-bold text-slate-300 font-mono uppercase">Salidas Profesionales</h4>
            <ul class="space-y-1 text-xs">${salidasHTML}</ul>
          </div>
        </div>
      `;
    }

    function actualizar() {
      const g1 = gradosOrdenados.find(g => (g.id || g.slug) === select1.value);
      const g2 = gradosOrdenados.find(g => (g.id || g.slug) === select2.value);

      if (g1 || g2) {
        if (container) container.style.display = 'grid';
        if (mensajeInicial) mensajeInicial.style.display = 'none';

        if (card1) card1.innerHTML = g1 ? renderGrado(g1) : '<p class="text-xs text-slate-500 text-center py-8">Selecciona el primer grado</p>';
        if (card2) card2.innerHTML = g2 ? renderGrado(g2) : '<p class="text-xs text-slate-500 text-center py-8">Selecciona el segundo grado</p>';
      } else {
        if (container) container.style.display = 'none';
        if (mensajeInicial) mensajeInicial.style.display = 'block';
      }
    }

    select1.addEventListener('change', actualizar);
    select2.addEventListener('change', actualizar);
  }

  document.addEventListener('DOMContentLoaded', setupComparador);
  document.addEventListener('astro:page-load', setupComparador);
  setupComparador();
</script>