---
import MainLayout from '../layouts/MainLayout.astro';
import grados from '../data/grados.json';
const grupos = Object.entries(grados.reduce((acc, g) => { const rama = (g.rama || 'Sin clasificar').trim(); (acc[rama] ||= []).push(g); return acc; }, {})).sort(([a],[b]) => a.localeCompare(b, 'es'));
---
<MainLayout title="Explorar grados por rama | UniMatchCAT" description="Descubre las ramas de conocimiento y las titulaciones incluidas en el catálogo UniMatchCAT.">
<div class="mx-auto max-w-5xl px-4 py-10 space-y-8"><header class="space-y-3"><p class="text-amber-400 text-xs font-bold uppercase tracking-widest">Catálogo</p><h1 class="text-3xl sm:text-5xl font-black text-white">Explora los grados por rama</h1><p class="text-slate-300 max-w-3xl">Estas agrupaciones se generan a partir de los registros que tenemos actualmente; no representan toda la oferta universitaria de Cataluña.</p></header><div class="grid md:grid-cols-2 gap-5">{grupos.map(([rama,items]) => <section class="rounded-2xl border border-slate-800 bg-slate-900/60 p-6 space-y-4"><div class="flex justify-between items-start gap-4"><h2 class="text-xl font-bold text-white">{rama}</h2><span class="text-amber-400 text-sm font-bold">{items.length}</span></div><ul class="space-y-2">{items.slice(0,8).map(g => <li><a class="text-sm text-slate-300 hover:text-amber-400" href={`/grados/${encodeURIComponent(g.id || g.slug)}`}>{g.nombre} <span class="text-slate-500">· {g.universidad}</span></a></li>)}</ul>{items.length>8 && <p class="text-xs text-slate-500">Y {items.length-8} registros más en esta rama.</p>}</section>)}</div><a href="/grados" class="inline-flex rounded-xl bg-amber-400 px-5 py-3 text-slate-950 font-bold">Ver el buscador completo →</a></div>
</MainLayout>
