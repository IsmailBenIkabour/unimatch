---
// src/pages/index.astro
import MainLayout from '../layouts/MainLayout.astro';
import CalculadoraPau from '../components/CalculadoraPau.astro';
---

<MainLayout title="UniMatchES | Calculadora PAU y Notas de Corte en España">
  <div class="space-y-12 py-4">
    
    <section class="text-center space-y-4 max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/20 text-amber-400 text-xs font-bold">
        <span>🎓</span> Orientación Universitaria España 2026
      </div>

      <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight leading-tight">
        Calcula tu nota de acceso y encuentra tu <span class="text-amber-400">Universidad ideal</span>
      </h1>
      
      <p class="text-slate-400 text-xs sm:text-sm leading-relaxed max-w-2xl mx-auto">
        Obtén tu nota final de admisión a la PAU/EBAU sobre 14 puntos, consulta notas de corte históricas y descubre en qué carreras tienes plaza asegurada.
      </p>
    </section>

    <section class="max-w-2xl mx-auto">
      <CalculadoraPau />
    </section>

  </div>
</MainLayout>