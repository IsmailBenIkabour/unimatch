---
// src/pages/index.astro
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="UniMatch | Portal de Admisión Universitaria España">
  <div class="text-center py-12 space-y-4">
    <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight">
      Encuentra tu carrera y universidad en <span class="text-amber-400">España</span>
    </h1>
    <p class="text-slate-400 text-sm sm:text-base max-w-2xl mx-auto">
      Calcula tu nota de admisión de la PAU, consulta el histórico de notas de corte y compara opciones públicas y privadas.
    </p>
  </div>
</MainLayout>