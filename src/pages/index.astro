---
// src/pages/index.astro
import MainLayout from '../layouts/MainLayout.astro';
import CalculadoraPau from '../components/CalculadoraPau.astro';
import BuscadorGrados from '../components/BuscadorGrados.astro';

import gradosData from '../data/grados.json';
const totalGrados = gradosData.length;
---

<MainLayout 
  title="UniMatchES | Orientación Universitaria y Notas de Corte"
  description="Calcula tu nota PAU sobre 14, descubre qué carreras puedes estudiar y compara universidades en España."
>
  <div class="space-y-16 py-8">
    
    <!-- HERO SECTION MINIMALISTA -->
    <section class="text-center space-y-4 max-w-2xl mx-auto px-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-slate-900 border border-slate-800 text-amber-400 text-xs font-medium tracking-wide">
        <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
        Convocatoria PAU / EBAU
      </div>
      
      <h1 class="text-4xl sm:text-6xl font-black text-white tracking-tight leading-[1.1]">
        Encuentra tu futuro <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 to-amber-200">universitario.</span>
      </h1>
      
      <p class="text-sm sm:text-base text-slate-400 font-normal leading-relaxed">
        Calcula tu nota de admisión sobre 14 puntos de forma instantánea y descubre en qué titulaciones de toda España puedes ser admitido.
      </p>

      <!-- DATOS CLAVE EN LÍNEA -->
      <div class="pt-2 flex flex-wrap justify-center gap-6 text-xs text-slate-400 font-mono">
        <div class="flex items-center gap-1.5">
          <span class="text-amber-400 font-bold">{totalGrados}</span> Titulaciones
        </div>
        <span class="text-slate-800">•</span>
        <div class="flex items-center gap-1.5">
          <span class="text-amber-400 font-bold">100%</span> Gratuito
        </div>
        <span class="text-slate-800">•</span>
        <div class="flex items-center gap-1.5">
          <span class="text-amber-400 font-bold">Oficial</span> España
        </div>
      </div>
    </section>

    <!-- SECCIÓN DE LA CALCULADORA -->
    <section class="max-w-xl mx-auto">
      <CalculadoraPau />
    </section>

    <!-- SECCIÓN DEL BUSCADOR -->
    <section id="buscadorSection" class="max-w-4xl mx-auto pt-6">
      <div class="text-center space-y-2 mb-8">
        <h2 class="text-2xl font-bold text-white tracking-tight">Explorador de Titulaciones</h2>
        <p class="text-xs text-slate-400">Filtra por nota de corte, rama de conocimiento o comunidad autónoma.</p>
      </div>
      <BuscadorGrados />
    </section>

  </div>
</MainLayout>