---
// src/pages/notas-de-corte.astro
import MainLayout from '../layouts/MainLayout.astro';
import gradosData from '../data/grados.json';

// Ordenar grados alfabéticamente por el nombre de la titulación
const gradosOrdenados = [...gradosData].sort((a, b) => {
  const nombreA = a?.nombre || '';
  const nombreB = b?.nombre || '';
  return nombreA.localeCompare(nombreB, 'ca', { sensitivity: 'accent' });
});
---

<MainLayout 
  title="Tabla Oficial de Notas de Corte Cataluña 2026 | UniMatch"
  description="Listado completo y ordenado alfabéticamente de notas de corte de la 2ª asignación para las universidades de Cataluña."
>
  <div class="space-y-8 py-8 max-w-5xl mx-auto px-4">
    <header class="text-center space-y-3 max-w-2xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-slate-900 border border-slate-800 text-amber-400 text-xs font-medium tracking-wide">
        Oficina d'Accés a la Universitat
      </div>
      <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight">
        Notas de Corte <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 to-amber-200">Cataluña 2026</span>
      </h1>
      <p class="text-xs sm:text-sm text-slate-400">
        Listado alfabético correspondiente a la 2ª asignación de plazas (julio 2026).
      </p>
    </header>

    <div class="overflow-x-auto bg-slate-900/60 border border-slate-800/80 rounded-2xl p-2 backdrop-blur-sm">
      <table class="w-full text-left text-xs text-slate-300">
        <thead class="bg-slate-950 text-slate-400 font-mono text-[11px] uppercase border-b border-slate-800">
          <tr>
            <th class="p-3.5">Titulación</th>
            <th class="p-3.5">Universidad</th>
            <th class="p-3.5">Ciudad</th>
            <th class="p-3.5 text-right">Nota Corte 2026</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-800/50">
          {gradosOrdenados.map(g => {
            if (!g || !g.nombre) return null;
            const notaFormateada = typeof g.notaCorte2026 === 'number' 
              ? g.notaCorte2026.toFixed(3) 
              : (g.notaCorte2026 || '0.000');

            return (
              <tr class="hover:bg-slate-800/30 transition-colors">
                <td class="p-3.5 font-bold text-white">{g.nombre}</td>
                <td class="p-3.5 text-slate-400">{g.universidad || 'N/A'}</td>
                <td class="p-3.5 text-slate-400">{g.ciudad || 'Cataluña'}</td>
                <td class="p-3.5 text-right font-mono font-bold text-amber-400">
                  {notaFormateada}
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </div>
</MainLayout>