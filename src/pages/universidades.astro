---
// src/pages/universidades.astro
import MainLayout from '../layouts/MainLayout.astro';
import gradosData from '../data/grados.json';

const universidadesMap = new Map();
gradosData.forEach(g => {
  if (!universidadesMap.has(g.universidadSlug)) {
    universidadesMap.set(g.universidadSlug, {
      slug: g.universidadSlug,
      nombre: g.universidad,
      comunidad: g.comunidad,
      tipo: g.tipo,
      grados: gradosData.filter(item => item.universidadSlug === g.universidadSlug)
    });
  }
});

const universidades = Array.from(universidadesMap.values());
---

<MainLayout 
  title="Universidades y Titulaciones | UniMatchES"
  description="Explora las universidades del catálogo y consulta qué carreras imparte cada una."
>
  <div class="space-y-8 py-6 max-w-4xl mx-auto">
    
    <div class="space-y-2">
      <h1 class="text-3xl sm:text-4xl font-black text-white tracking-tight">
        Universidades y sus <span class="text-amber-400">Titulaciones</span>
      </h1>
      <p class="text-xs sm:text-sm text-slate-400">
        Haz clic en cualquier universidad para desplegar y ver todas las carreras que ofrece.
      </p>
    </div>

    <!-- BARRA DE BÚSQUEDA RÁPIDA -->
    <div class="bg-slate-900/60 border border-slate-800/80 rounded-2xl p-4 backdrop-blur-sm">
      <input 
        type="text" 
        id="searchUniInput" 
        placeholder="🔍 Buscar universidad o comunidad..." 
        class="w-full bg-slate-950 border border-slate-800 focus:border-amber-400 rounded-xl px-4 py-3 text-xs text-white outline-none transition"
      />
    </div>

    <!-- GRID / LISTADO DE UNIVERSIDADES -->
    <div id="universidadesContainer" class="space-y-4">
      <!-- Renderizado por JS -->
    </div>

  </div>
</MainLayout>

<script type="application/json" id="unis-json" set:html={JSON.stringify(universidades)} />

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const jsonElement = document.getElementById('unis-json');
    if (!jsonElement) return;

    const todasLasUniversidades = JSON.parse(jsonElement.textContent || '[]');
    const searchInput = document.getElementById('searchUniInput');
    const container = document.getElementById('universidadesContainer');

    function renderUniversidades(unis) {
      if (unis.length === 0) {
        container.innerHTML = `<div class="py-8 text-center text-slate-500 text-xs">No se han encontrado universidades.</div>`;
        return;
      }

      container.innerHTML = unis.map((uni, index) => `
        <div class="bg-slate-900/40 border border-slate-800/80 rounded-2xl p-5 backdrop-blur-xl space-y-4 transition-all">
          <div class="flex flex-wrap justify-between items-start gap-2 cursor-pointer" onclick="toggleUniDetalle('${uni.slug}')">
            <div class="space-y-1">
              <div class="flex items-center gap-2">
                <span class="text-[10px] font-bold px-2.5 py-1 rounded-full bg-slate-800 text-slate-300">${uni.tipo}</span>
                <span class="text-xs font-mono text-amber-400 bg-amber-400/10 px-2 py-0.5 rounded-md">${uni.grados.length} titulaciones</span>
              </div>
              <h2 class="text-base font-bold text-white pt-1 hover:text-amber-400 transition-colors">
                ${uni.nombre}
              </h2>
            </div>
            <div class="text-xs text-slate-400 flex items-center gap-1 font-semibold pt-2">
              <span>📍 ${uni.comunidad}</span>
              <span id="arrow-${uni.slug}" class="text-amber-400 text-sm ml-2">▼ Desplegar</span>
            </div>
          </div>

          <!-- LISTA DE TITULACIONES DESPLEGABLE -->
          <div id="detalle-${uni.slug}" class="hidden pt-4 border-t border-slate-800 space-y-2">
            <p class="text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-2">Titulaciones impartidas:</p>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
              ${uni.grados.map(g => `
                <a href="/grados/${g.id}" class="bg-slate-950/80 hover:bg-slate-800/60 p-3 rounded-xl border border-slate-800/60 flex justify-between items-center text-xs transition-colors group">
                  <span class="font-semibold text-slate-200 group-hover:text-amber-400">${g.nombre}</span>
                  <span class="text-[11px] font-mono text-amber-400 font-bold">Corte: ${g.notaCorte2026.toFixed(3)}</span>
                </a>
              `).join('')}
            </div>
          </div>
        </div>
      `).join('');
    }

    // Función global para desplegar/contraer
    window.toggleUniDetalle = function(slug) {
      const detalle = document.getElementById(`detalle-${slug}`);
      const arrow = document.getElementById(`arrow-${slug}`);
      if (detalle.classList.contains('hidden')) {
        detalle.classList.remove('hidden');
        arrow.innerText = '▲ Ocultar';
      } else {
        detalle.classList.add('hidden');
        arrow.innerText = '▼ Desplegar';
      }
    };

    function filtrarUniversidades() {
      const texto = searchInput.value.toLowerCase().trim();
      const filtradas = todasLasUniversidades.filter(uni => 
        uni.nombre.toLowerCase().includes(texto) || 
        uni.comunidad.toLowerCase().includes(texto)
      );
      renderUniversidades(filtradas);
    }

    searchInput.addEventListener('input', filtrarUniversidades);
    renderUniversidades(todasLasUniversidades);
  });
</script>