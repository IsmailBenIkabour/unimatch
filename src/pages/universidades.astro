---
// src/pages/universidades.astro
import MainLayout from '../layouts/MainLayout.astro';

const universidades = [
  { nombre: "Universitat de Barcelona", sigles: "UB", ciudad: "Barcelona", tipo: "Pública" },
  { nombre: "Universitat Autònoma de Barcelona", sigles: "UAB", ciudad: "Cerdanyola del Vallès", tipo: "Pública" },
  { nombre: "Universitat Politècnica de Catalunya", sigles: "UPC", ciudad: "Barcelona", tipo: "Pública" },
  { nombre: "Universitat Pompeu Fabra", sigles: "UPF", ciudad: "Barcelona", tipo: "Pública" },
  { nombre: "Universitat de Girona", sigles: "UdG", ciudad: "Girona", tipo: "Pública" },
  { nombre: "Universitat de Lleida", sigles: "UdL", ciudad: "Lleida", tipo: "Pública" },
  { nombre: "Universitat Rovira i Virgili", sigles: "URV", ciudad: "Tarragona / Reus", tipo: "Pública" },
  { nombre: "Universitat de Vic - UCC", sigles: "UVic-UCC", ciudad: "Vic / Manresa", tipo: "Pública / Concertada" }
];
---

<MainLayout 
  title="Universidades de Cataluña | UniMatch"
  description="Directorio de universidades públicas y centros universitarios del sistema educativo catalán."
>
  <div class="space-y-10 py-8 max-w-5xl mx-auto px-4">
    <header class="text-center space-y-3 max-w-2xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-slate-900 border border-slate-800 text-amber-400 text-xs font-medium tracking-wide">
        Distrito Universitario Catalán
      </div>
      <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight">
        Universidades de <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 to-amber-200">Cataluña</span>
      </h1>
      <p class="text-xs sm:text-sm text-slate-400">
        Centros educativos y universidades oficiales incluidas en la asignación de plazas.
      </p>
    </header>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {universidades.map(u => (
        <div class="bg-slate-900/60 border border-slate-800/80 rounded-2xl p-5 flex flex-col justify-between space-y-4">
          <div class="space-y-2">
            <span class="text-[10px] font-bold px-2.5 py-1 rounded-full bg-amber-400/10 text-amber-400 border border-amber-400/20">
              {u.sigles}
            </span>
            <h3 class="text-sm font-bold text-white leading-snug pt-1">{u.nombre}</h3>
            <p class="text-xs text-slate-400">📍 {u.ciudad}</p>
          </div>
          <span class="text-[11px] font-semibold text-slate-400 border-t border-slate-800/80 pt-3 block">
            Centro {u.tipo}
          </span>
        </div>
      ))}
    </div>
  </div>
</MainLayout>