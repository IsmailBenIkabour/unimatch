---
// src/components/ComparadorGrados.astro
import gradosData from '../data/grados.json';
---

<div class="space-y-6">
  
  <!-- SELECTORES DE COMPARACIÓN -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div class="bg-slate-900/60 border border-slate-800/80 rounded-2xl p-4">
      <label for="gradoSelect1" class="block text-[11px] font-semibold text-slate-400 mb-2">Selecciona el primer grado</label>
      <select id="gradoSelect1" class="w-full bg-slate-950 border border-slate-800 focus:border-amber-400 rounded-xl px-3 py-2.5 text-xs text-white outline-none">
        <option value="">-- Elige titulación --</option>
        {gradosData.map(g => (
          <option value={g.id}>{g.nombre} ({g.universidad})</option>
        ))}
      </select>
    </div>

    <div class="bg-slate-900/60 border border-slate-800/80 rounded-2xl p-4">
      <label for="gradoSelect2" class="block text-[11px] font-semibold text-slate-400 mb-2">Selecciona el segundo grado</label>
      <select id="gradoSelect2" class="w-full bg-slate-950 border border-slate-800 focus:border-amber-400 rounded-xl px-3 py-2.5 text-xs text-white outline-none">
        <option value="">-- Elige titulación --</option>
        {gradosData.map(g => (
          <option value={g.id}>{g.nombre} ({g.universidad})</option>
        ))}
      </select>
    </div>
  </div>

  <!-- TABLA COMPARATIVA -->
  <div id="comparadorContainer" class="hidden bg-slate-900/60 border border-slate-800/80 rounded-2xl p-6 backdrop-blur-sm">
    <div class="grid grid-cols-3 gap-4 text-xs">
      <div class="font-bold text-slate-400 uppercase tracking-wider">Criterio</div>
      <div id="nombreGrado1" class="font-bold text-amber-400">Grado 1</div>
      <div id="nombreGrado2" class="font-bold text-amber-400">Grado 2</div>
      
      <div class="py-3 border-t border-slate-800 text-slate-400">Nota de Corte 2026</div>
      <div id="notaGrado1" class="py-3 border-t border-slate-800 font-mono font-bold text-white">--</div>
      <div id="notaGrado2" class="py-3 border-t border-slate-800 font-mono font-bold text-white">--</div>

      <div class="py-3 border-t border-slate-800 text-slate-400">Universidad</div>
      <div id="uniGrado1" class="py-3 border-t border-slate-800 text-slate-300">--</div>
      <div id="uniGrado2" class="py-3 border-t border-slate-800 text-slate-300">--</div>

      <div class="py-3 border-t border-slate-800 text-slate-400">Rama</div>
      <div id="ramaGrado1" class="py-3 border-t border-slate-800 text-slate-300">--</div>
      <div id="ramaGrado2" class="py-3 border-t border-slate-800 text-slate-300">--</div>

      <div class="py-3 border-t border-slate-800 text-slate-400">Población</div>
      <div id="ciudadGrado1" class="py-3 border-t border-slate-800 text-slate-300">--</div>
      <div id="ciudadGrado2" class="py-3 border-t border-slate-800 text-slate-300">--</div>
    </div>
  </div>

</div>

<!-- DATA PASSTHROUGH -->
<script type="application/json" id="comparador-json" set:html={JSON.stringify(gradosData)} />

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const jsonEl = document.getElementById('comparador-json');
    if (!jsonEl) return;
    const datos = JSON.parse(jsonEl.textContent || '[]');

    const select1 = document.getElementById('gradoSelect1');
    const select2 = document.getElementById('gradoSelect2');
    const container = document.getElementById('comparadorContainer');

    function actualizarComparacion() {
      const g1 = datos.find(g => g.id === select1.value);
      const g2 = datos.find(g => g.id === select2.value);

      if (!g1 || !g2) {
        container.classList.add('hidden');
        return;
      }

      container.classList.remove('hidden');

      document.getElementById('nombreGrado1').innerText = g1.nombre;
      document.getElementById('notaGrado1').innerText = g1.notaCorte2026.toFixed(3);
      document.getElementById('uniGrado1').innerText = g1.universidad;
      document.getElementById('ramaGrado1').innerText = g1.rama;
      document.getElementById('ciudadGrado1').innerText = g1.ciudad;

      document.getElementById('nombreGrado2').innerText = g2.nombre;
      document.getElementById('notaGrado2').innerText = g2.notaCorte2026.toFixed(3);
      document.getElementById('uniGrado2').innerText = g2.universidad;
      document.getElementById('ramaGrado2').innerText = g2.rama;
      document.getElementById('ciudadGrado2').innerText = g2.ciudad;
    }

    select1.addEventListener('change', actualizarComparacion);
    select2.addEventListener('change', actualizarComparacion);
  });
</script>