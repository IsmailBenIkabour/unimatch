---
// src/components/Footer.astro
---

<footer class="bg-slate-950 border-t border-slate-800 py-8 mt-auto">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 flex flex-col md:flex-row items-center justify-between gap-4 text-center md:text-left">
    
    <div class="space-y-1">
      <a href="/" class="font-black text-lg text-amber-400 flex items-center justify-center md:justify-start gap-1.5">
        <span>🎓</span> UniMatch
      </a>
      <p class="text-xs text-slate-500">
        Portal independiente de orientación universitaria y datos de admisión en España.
      </p>
    </div>

    <div class="flex flex-wrap justify-center gap-6 text-xs text-slate-400">
      <a href="/privacidad" class="hover:text-amber-400 transition">Privacidad</a>
      <a href="/aviso-legal" class="hover:text-amber-400 transition">Aviso Legal</a>
      <a href="/metodologia" class="hover:text-amber-400 transition">Fuentes y Datos</a>
    </div>

    <p class="text-xs text-slate-600">
      &copy; {new Date().getFullYear()} UniMatch. Todos los derechos reservados.
    </p>

  </div>
</footer>