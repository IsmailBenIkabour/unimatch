---
// src/components/Header.astro
---

<header class="w-full bg-slate-950/80 border-b border-slate-800/80 sticky top-0 z-50 backdrop-blur-md px-4 sm:px-6 py-4">
  <div class="max-w-6xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-4">
    
    <!-- BRAND LOGO & BADGE -->
    <div class="flex items-center gap-3">
      <a href="/" class="text-xl font-black text-white tracking-tight flex items-center gap-2 group">
        UniMatch<span class="text-amber-400">CAT</span>
      </a>
      <span class="text-[10px] font-bold font-mono px-2 py-0.5 rounded-full bg-amber-400/10 text-amber-400 border border-amber-400/20">
        Cataluña 2026
      </span>
    </div>

    <!-- NAVEGACIÓN PRINCIPAL -->
    <nav class="flex flex-wrap items-center justify-center gap-6 text-xs font-semibold text-slate-300">
      <a href="/grados" class="hover:text-amber-400 transition-colors">Grados</a>
      <a href="/universidades" class="hover:text-amber-400 transition-colors">Universidades</a>
      <a href="/calculadora-pau" class="hover:text-amber-400 transition-colors">Calculadora PAU</a>
      <a href="/comparar" class="hover:text-amber-400 transition-colors">Comparar</a>
    </nav>

  </div>
</header>