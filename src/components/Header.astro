---
// src/components/Header.astro
---

<header class="bg-slate-900/90 backdrop-blur-md border-b border-slate-800 sticky top-0 z-50">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
    
    <!-- LOGO UNIMATCH -->
    <a href="/" class="flex items-center gap-2 font-black text-xl text-amber-400 hover:text-amber-300 transition">
      <span class="text-2xl">🎓</span>
      <span>UniMatch</span>
    </a>

    <!-- MENÚ DE NAVEGACIÓN -->
    <nav class="hidden md:flex items-center gap-6 text-xs font-semibold text-slate-300">
      <a href="/calculadora-pau" class="hover:text-amber-400 transition">Calculadora PAU</a>
      <a href="/notas-de-corte" class="hover:text-amber-400 transition">Notas de Corte</a>
      <a href="/grados" class="hover:text-amber-400 transition">Grados</a>
      <a href="/universidades" class="hover:text-amber-400 transition">Universidades</a>
    </nav>

    <!-- BADGE DE PROCESO DE ADMISIÓN -->
    <div class="flex items-center gap-3">
      <span class="text-[11px] font-bold px-3 py-1 rounded-full bg-amber-500/10 text-amber-400 border border-amber-500/30">
        Admisión 2026/2027
      </span>
    </div>

  </div>
</header>