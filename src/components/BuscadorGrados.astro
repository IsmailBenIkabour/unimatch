---
// src/components/BuscadorGrados.astro
import gradosData from '../data/grados.json';

// Extraer comunidades únicas para el selector y ordenarlas
const comunidades = [...new Set(gradosData.map(g => g.comunidad))].sort();
---

<div class="space-y-6">
  
  <!-- BARRA DE FILTROS MINIMALISTA -->
  <div class="bg-slate-900/60 border border-slate-800/80 rounded-2xl p-4 sm:p-6 backdrop-blur-sm grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
    
    <!-- Filtro Texto -->
    <div class="space-y-1">
      <label for="searchInput" class="block text-[11px] font-semibold text-slate-400">Buscar titulación o ciudad</label>
      <input 
        type="text" 
        id="searchInput" 
        placeholder="Ej. Medicina, Barcelona..." 
        class="w-full bg-slate-950 border border-slate-800 focus:border-amber-400 rounded-xl px-3 py-2.5 text-xs text-white outline-none transition"
      />
    </div>

    <!-- Filtro Nota Máxima -->
    <div class="space-y-1">
      <label for="maxNotaInput" class="block text-[11px] font-semibold text-slate-400">Tu Nota Máxima</label>
      <input 
        type="number" 
        id="maxNotaInput" 
        step="0.01" 
        min="5" 
        max="14" 
        placeholder="Ej. 11.50" 
        class="w-full bg-slate-950 border border-slate-800 focus:border-amber-400 rounded-xl px-3 py-2.5 text-xs font-bold text-amber-400 outline-none transition"
      />
    </div>

    <!-- Filtro Tipo -->
    <div class="space-y-1">
      <label for="tipoSelect" class="block text-[11px] font-semibold text-slate-400">Tipo de Centro</label>
      <select 
        id="tipoSelect" 
        class="w-full bg-slate-950 border border-slate-800 focus:border-amber-400 rounded-xl px-3 py-2.5 text-xs text-slate-200 outline-none transition"
      >
        <option value="">Todas las universidades</option>
        <option value="Pública">Públicas</option>
        <option value="Privada">Privadas</option>
        <option value="Online">Online</option>
      </select>
    </div>

    <!-- Filtro Comunidad -->
    <div class="space-y-1">
      <label for="comunidadSelect" class="block text-[11px] font-semibold text-slate-400">Comunidad Autónoma</label>
      <select 
        id="comunidadSelect" 
        class="w-full bg-slate-950 border border-slate-800 focus:border-amber-400 rounded-xl px-3 py-2.5 text-xs text-slate-200 outline-none transition"
      >
        <option value="">Toda España</option>
        {comunidades.map(comunidad => (
          <option value={comunidad}>{comunidad}</option>
        ))}
      </select>
    </div>

  </div>

  <!-- CONTADOR DE RESULTADOS -->
  <div class="flex justify-between items-center px-1">
    <span id="contadorResultados" class="text-xs text-slate-400 font-mono">Cargando titulaciones...</span>
  </div>

  <!-- LISTADO DE TARJETAS DE GRADOS -->
  <div id="gradosContainer" class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <!-- Renderizado por JS -->
  </div>

</div>

<!-- SCRIPT DE FILTRADO Y ORDEN ALFABÉTICO SEGURO -->
<script type="application/json" id="grados-json" set:html={JSON.stringify(gradosData)} />

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const jsonElement = document.getElementById('grados-json');
    if (!jsonElement) return;
    
    const todosLosGrados = JSON.parse(jsonElement.textContent || '[]');

    const searchInput = document.getElementById('searchInput');
    const maxNotaInput = document.getElementById('maxNotaInput');
    const tipoSelect = document.getElementById('tipoSelect');
    const comunidadSelect = document.getElementById('comunidadSelect');

    function filtrarGrados() {
      const texto = searchInput.value.toLowerCase().trim();
      const notaMaxVal = maxNotaInput.value.replace(',', '.');
      const notaMax = notaMaxVal ? parseFloat(notaMaxVal) : null;
      const tipo = tipoSelect.value;
      const comunidad = comunidadSelect.value;

      const filtrados = todosLosGrados.filter(g => {
        const coincideTexto = g.nombre.toLowerCase().includes(texto) || g.ciudad.toLowerCase().includes(texto) || g.universidad.toLowerCase().includes(texto);
        if (!coincideTexto) return false;

        if (notaMax !== null && !isNaN(notaMax)) {
          if (g.notaCorte2026 > notaMax) return false;
        }

        if (tipo && !g.tipo.toLowerCase().includes(tipo.toLowerCase())) return false;
        if (comunidad && g.comunidad !== comunidad) return false;

        return true;
      });

      // Ordenar alfabéticamente por nombre de la titulación (A-Z)
      filtrados.sort((a, b) => a.nombre.localeCompare(b.nombre));

      renderizarGrados(filtrados);
    }

    function renderizarGrados(grados) {
      const container = document.getElementById('gradosContainer');
      const contador = document.getElementById('contadorResultados');
      
      contador.innerText = `${grados.length} titulaciones encontradas`;

      if (grados.length === 0) {
        container.innerHTML = `
          <div class="col-span-full py-12 text-center bg-slate-900/40 border border-slate-800 rounded-2xl space-y-2">
            <p class="text-sm font-semibold text-slate-300">No se han encontrado titulaciones con estos filtros.</p>
            <p class="text-xs text-slate-500">Prueba a subir tu nota máxima o limpiar los filtros de búsqueda.</p>
          </div>
        `;
        return;
      }

      container.innerHTML = grados.map(g => `
        <a 
          href="/grados/${g.id}" 
          class="group bg-slate-900/60 hover:bg-slate-900 border border-slate-800/80 hover:border-amber-400/50 rounded-2xl p-5 transition-all duration-300 flex flex-col justify-between space-y-4"
        >
          <div class="space-y-2">
            <div class="flex justify-between items-start gap-2">
              <span class="text-[10px] font-bold px-2.5 py-1 rounded-full bg-slate-800 text-slate-300">
                ${g.rama}
              </span>
              <span class="text-xs font-mono font-bold text-amber-400 bg-amber-400/10 border border-amber-400/20 px-2.5 py-1 rounded-full">
                Corte: ${g.notaCorte2026.toFixed(3)}
              </span>
            </div>

            <div>
              <h3 class="text-sm font-bold text-white group-hover:text-amber-400 transition-colors leading-snug">
                ${g.nombre}
              </h3>
              <p class="text-xs text-slate-400 mt-1">${g.universidad}</p>
            </div>
          </div>

          <div class="pt-3 border-t border-slate-800/80 flex justify-between items-center text-[11px] text-slate-400">
            <span>📍 ${g.ciudad} (${g.comunidad})</span>
            <span class="font-semibold text-slate-300 group-hover:translate-x-0.5 transition-transform">Ver ficha →</span>
          </div>
        </a>
      `).join('');
    }

    // Event listeners
    searchInput.addEventListener('input', filtrarGrados);
    maxNotaInput.addEventListener('input', filtrarGrados);
    tipoSelect.addEventListener('change', filtrarGrados);
    comunidadSelect.addEventListener('change', filtrarGrados);

    // Render inicial ordenado alfabéticamente
    const gradosIniciales = [...todosLosGrados].sort((a, b) => a.nombre.localeCompare(b.nombre));
    renderizarGrados(gradosIniciales);
  });
</script>