---
// src/components/BuscadorGrados.astro
import gradosData from '../data/grados.json';

// Ordenar grados alfabéticamente de forma 100% segura (evita undefined)
const gradosOrdenados = [...gradosData].sort((a, b) => {
  const nombreA = a && a.nombre ? String(a.nombre) : '';
  const nombreB = b && b.nombre ? String(b.nombre) : '';
  return nombreA.localeCompare(nombreB);
});

// Extraer universidades únicas de Cataluña
const universidades = [...new Set(gradosData.map(g => g && g.universidad).filter(Boolean))].sort();
---

<div class="space-y-6">
  
  <!-- BARRA DE FILTROS MINIMALISTA -->
  <div class="bg-slate-900/60 border border-slate-800/80 rounded-2xl p-4 sm:p-6 backdrop-blur-sm grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
    
    <!-- Filtro Texto -->
    <div class="space-y-1">
      <label for="searchInput" class="block text-[11px] font-semibold text-slate-400">Buscar titulación o ciudad</label>
      <input 
        type="text" 
        id="searchInput" 
        placeholder="Ej. Medicina, Barcelona..." 
        class="w-full bg-slate-950 border border-slate-800 focus:border-amber-400 rounded-xl px-3 py-2.5 text-xs text-white outline-none transition"
      />
    </div>

    <!-- Filtro Nota Máxima -->
    <div class="space-y-1">
      <label for="maxNotaInput" class="block text-[11px] font-semibold text-slate-400">Tu Nota Máxima</label>
      <input 
        type="number" 
        step="0.01" 
        id="maxNotaInput" 
        min="5" 
        max="14" 
        placeholder="Ej. 11.50" 
        class="w-full bg-slate-950 border border-slate-800 focus:border-amber-400 rounded-xl px-3 py-2.5 text-xs font-bold text-amber-400 outline-none transition"
      />
    </div>

    <!-- Filtro Tipo -->
    <div class="space-y-1">
      <label for="tipoSelect" class="block text-[11px] font-semibold text-slate-400">Tipo de Centro</label>
      <select 
        id="tipoSelect" 
        class="w-full bg-slate-950 border border-slate-800 focus:border-amber-400 rounded-xl px-3 py-2.5 text-xs text-slate-200 outline-none transition"
      >
        <option value="">Todas las universidades</option>
        <option value="Pública">Públicas</option>
        <option value="Privada">Privadas</option>
      </select>
    </div>

    <!-- Filtro Universidad de Cataluña -->
    <div class="space-y-1">
      <label for="universidadSelect" class="block text-[11px] font-semibold text-slate-400">Universidad (Cataluña)</label>
      <select 
        id="universidadSelect" 
        class="w-full bg-slate-950 border border-slate-800 focus:border-amber-400 rounded-xl px-3 py-2.5 text-xs text-slate-200 outline-none transition"
      >
        <option value="">Todas de Cataluña</option>
        {universidades.map(uni => (
          <option value={uni}>{uni}</option>
        ))}
      </select>
    </div>

  </div>

  <!-- CONTADOR DE RESULTADOS -->
  <div class="flex justify-between items-center px-1">
    <span id="contadorResultados" class="text-xs text-slate-400 font-mono">
      {gradosOrdenados.length} titulaciones encontradas
    </span>
  </div>

  <!-- LISTADO DE TARJETAS (Renderizado estático directo de Astro) -->
  <div id="gradosContainer" class="grid grid-cols-1 md:grid-cols-2 gap-4">
    {gradosOrdenados.map(g => {
      if (!g || !g.nombre) return null;
      const idTarget = g.id || g.slug || '';
      const notaFormateada = typeof g.notaCorte2026 === 'number' ? g.notaCorte2026.toFixed(3) : (g.notaCorte2026 || '0.000');

      return (
        <a 
          href={`/grados/${idTarget}`} 
          data-nombre={String(g.nombre).toLowerCase()}
          data-ciudad={String(g.ciudad || '').toLowerCase()}
          data-universidad={g.universidad || ''}
          data-nota={g.notaCorte2026 || 0}
          data-tipo={g.tipo || 'Pública'}
          class="grado-card group bg-slate-900/60 hover:bg-slate-900 border border-slate-800/80 hover:border-amber-400/50 rounded-2xl p-5 transition-all duration-300 flex flex-col justify-between space-y-4"
        >
          <div class="space-y-2">
            <div class="flex justify-between items-start gap-2">
              <span class="text-[10px] font-bold px-2.5 py-1 rounded-full bg-slate-800 text-slate-300">
                {g.rama || 'Grado'}
              </span>
              <span class="text-xs font-mono font-bold text-amber-400 bg-amber-400/10 border border-amber-400/20 px-2.5 py-1 rounded-full">
                Corte: {notaFormateada}
              </span>
            </div>

            <div>
              <h3 class="text-sm font-bold text-white group-hover:text-amber-400 transition-colors leading-snug">
                {g.nombre}
              </h3>
              <p class="text-xs text-slate-400 mt-1">{g.universidad}</p>
            </div>
          </div>

          <div class="pt-3 border-t border-slate-800/80 flex justify-between items-center text-[11px] text-slate-400">
            <span>📍 {g.ciudad || 'Cataluña'} ({g.comunidad || 'Cataluña'})</span>
            <span class="font-semibold text-slate-300 group-hover:translate-x-0.5 transition-transform">Ver ficha →</span>
          </div>
        </a>
      );
    })}
  </div>

  <!-- MENSAJE DE NO RESULTADOS -->
  <div id="noResultados" class="hidden py-12 text-center bg-slate-900/40 border border-slate-800 rounded-2xl space-y-2">
    <p class="text-sm font-semibold text-slate-300">No se han encontrado titulaciones con estos filtros.</p>
    <p class="text-xs text-slate-500">Prueba a subir tu nota máxima o limpiar los filtros de búsqueda.</p>
  </div>

</div>

<!-- SCRIPT DE FILTRADO CLIENTE -->
<script>
  function setupFiltros() {
    const searchInput = document.getElementById('searchInput') as HTMLInputElement;
    const maxNotaInput = document.getElementById('maxNotaInput') as HTMLInputElement;
    const tipoSelect = document.getElementById('tipoSelect') as HTMLSelectElement;
    const universidadSelect = document.getElementById('universidadSelect') as HTMLSelectElement;
    
    const cards = document.querySelectorAll('.grado-card');
    const contador = document.getElementById('contadorResultados');
    const noResultados = document.getElementById('noResultados');

    if (!cards.length) return;

    function filtrar() {
      const texto = searchInput?.value.toLowerCase().trim() || '';
      const notaMaxVal = maxNotaInput?.value.replace(',', '.') || '';
      const notaMax = notaMaxVal ? parseFloat(notaMaxVal) : null;
      const tipo = tipoSelect?.value || '';
      const universidad = universidadSelect?.value || '';

      let visibles = 0;

      cards.forEach(card => {
        const el = card as HTMLElement;
        const nombre = el.dataset.nombre || '';
        const ciudad = el.dataset.ciudad || '';
        const uniCard = el.dataset.universidad || '';
        const tipoCard = el.dataset.tipo || '';
        const notaCard = parseFloat(el.dataset.nota || '0');

        const coincideTexto = !texto || nombre.includes(texto) || ciudad.includes(texto) || uniCard.toLowerCase().includes(texto);
        const coincideNota = notaMax === null || isNaN(notaMax) || notaCard <= notaMax;
        const coincideTipo = !tipo || tipoCard.toLowerCase().includes(tipo.toLowerCase());
        const coincideUni = !universidad || uniCard === universidad;

        if (coincideTexto && coincideNota && coincideTipo && coincideUni) {
          el.style.display = 'flex';
          visibles++;
        } else {
          el.style.display = 'none';
        }
      });

      if (contador) {
        contador.innerText = `${visibles} titulaciones encontradas`;
      }

      if (noResultados) {
        noResultados.style.display = visibles === 0 ? 'block' : 'none';
      }
    }

    searchInput?.addEventListener('input', filtrar);
    maxNotaInput?.addEventListener('input', filtrar);
    tipoSelect?.addEventListener('change', filtrar);
    universidadSelect?.addEventListener('change', filtrar);
  }

  document.addEventListener('DOMContentLoaded', setupFiltros);
  document.addEventListener('astro:page-load', setupFiltros);
  setupFiltros();
</script>