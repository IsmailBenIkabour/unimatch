---
// src/layouts/MainLayout.astro
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { 
  title, 
  description = "Descubre las notas de corte, ponderaciones y grados universitarios en Cataluña. Tu futuro empieza en UniMatchCAT."
} = Astro.props;

const site = 'https://unimatchcat.netlify.app';
const canonicalURL = new URL(Astro.url.pathname, site);
---

<!DOCTYPE html>
<html lang="es" class="h-full bg-slate-950">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- Título y Descripción SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- URL Canónica -->
    <link rel="canonical" href={canonicalURL.toString()} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL.toString()} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="UniMatchCAT" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
  </head>
  <body class="h-full font-sans text-slate-100 bg-slate-950 antialiased selection:bg-amber-400 selection:text-slate-950 flex flex-col min-h-screen">
    
    <!-- MENÚ DE NAVEGACIÓN DIRECTO EN EL LAYOUT -->
    <header class="border-b border-slate-900 bg-slate-950/80 backdrop-blur-md sticky top-0 z-50">
      <div class="max-w-5xl mx-auto px-4 h-16 flex items-center justify-between">
        <a href="/" class="font-black text-white text-lg tracking-tight flex items-center gap-2">
          UniMatch<span class="text-amber-400">CAT</span>
        </a>
        <nav class="flex items-center gap-3 sm:gap-5 text-xs font-semibold">
          <a href="/grados" class="text-slate-300 hover:text-amber-400 transition">Grados</a>
          <a href="/universidades" class="text-slate-300 hover:text-amber-400 transition">Universidades</a>
          <a href="/notas-de-corte" class="text-slate-300 hover:text-amber-400 transition">Notas de Corte</a>
          <a href="/comparar" class="text-slate-300 hover:text-amber-400 transition">Comparar</a>
          <a href="/metodologia" class="text-slate-300 hover:text-amber-400 transition hidden sm:inline-block">Metodología</a>
          <a href="/contacto" class="text-slate-300 hover:text-amber-400 transition hidden sm:inline-block">Contacto</a>
        </nav>
      </div>
    </header>

    <!-- Contenido Principal -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Pie de página -->
    <footer class="border-t border-slate-900 bg-slate-950 py-8 text-xs text-slate-500">
      <div class="max-w-5xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-4">
        <p>© 2026 UniMatchCAT. Datos oficiales de la Generalitat de Catalunya.</p>
        <div class="flex items-center gap-6">
          <a href="/aviso-legal" class="hover:text-slate-300 transition">Aviso Legal</a>
          <a href="/privacidad" class="hover:text-slate-300 transition">Privacidad</a>
          <a href="/contacto" class="hover:text-slate-300 transition">Contacto</a>
        </div>
      </div>
    </footer>

  </body>
</html>